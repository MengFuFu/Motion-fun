<?xml version="1.0" encoding="utf-8"?>
<!--
  监测页分三层，从下往上叠：
    1) PreviewView  —— 相机画面，铺满整屏（永远是底层）
    2) panel_state  —— 状态面板，只有「没权限 / 没相机 / 出错」时才显示，
                       它自带不透明背景，会把预览完全盖住
    3) tv_preview_badge —— 右上角小胶囊，出画面后显示「前置相机 · 就绪」

  为什么用 FrameLayout 叠而不是切换 Visibility 的两个页面：
  相机预览一旦 unbind 再 bind 会有 1~2 秒黑屏，叠加式可以让预览一直在底层待命，
  只切上面那层的显隐，视觉上更连贯。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/camera_backdrop">

    <!-- ① 相机画面 -->
    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="compatible"
        app:scaleType="fillCenter" />

    <!-- ② 状态面板：默认可见，进入就绪态后由代码隐藏 -->
    <LinearLayout
        android:id="@+id/panel_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_page"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_xl"
        android:paddingVertical="@dimen/space_xl">

        <ImageView
            android:id="@+id/iv_state_icon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_nav_monitor"
            app:tint="@color/brand_primary" />

        <TextView
            android:id="@+id/tv_state_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:fontFamily="sans-serif-medium"
            android:text="@string/camera_need_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_title" />

        <TextView
            android:id="@+id/tv_state_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:text="@string/camera_need_desc_first"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_state_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:minWidth="220dp"
            android:minHeight="56dp"
            android:text="@string/camera_grant"
            android:textSize="@dimen/text_body"
            app:backgroundTint="@color/brand_primary"
            app:cornerRadius="@dimen/radius_button" />

    </LinearLayout>

    <!-- ③ 就绪胶囊：半透明黑底 + 白字，避免在浅色画面里看不清 -->
    <TextView
        android:id="@+id/tv_preview_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="@dimen/space_m"
        android:background="@drawable/bg_badge"
        android:paddingHorizontal="@dimen/space_m"
        android:paddingVertical="@dimen/space_s"
        android:textColor="@color/white"
        android:textSize="@dimen/text_caption"
        android:visibility="gone"
        tools:text="前置相机 · 就绪"
        xmlns:tools="http://schemas.android.com/tools" />

    <!-- ④ 调试 HUD：等宽字体，左下角。
     别小看这一行文字，T05 到 T08 全靠它判断"模型是不是真的在跑"。 -->
    <TextView
        android:id="@+id/tv_hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="@dimen/space_m"
        android:background="@drawable/bg_badge"
        android:fontFamily="monospace"
        android:paddingHorizontal="@dimen/space_m"
        android:paddingVertical="@dimen/space_s"
        android:text="@string/pose_hud_idle"
        android:textColor="@color/white"
        android:textSize="@dimen/text_caption"
        android:visibility="gone" />

</FrameLayout>